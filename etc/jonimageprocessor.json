{
  "configDirectory": "/opt/JONImageProcessor/etc/overlays",
  "camera": {
    "enabled": true,
    "device": "/dev/video0",
    "format": "MJPG",
    "connectTimeoutSeconds": 10
  },
  "secondaryCamera": {
    "pipeline": "tcpclientsrc host=127.0.0.1 port=5000 ! rawvideoparse format=bgr width=1280 height=720 framerate=30/1 ! video/x-raw,format=BGR,width=1280,height=720,framerate=30/1 ! queue leaky=downstream max-size-buffers=1 ! appsink drop=true max-buffers=1 sync=false"
  },
  "processing": {
    "size": "1280x720"
  },
  "segmentation": {
    "size": "384x384",
    "maskModel": "models/modnet_photographic_portrait_matting.onnx",
    "threshold": 0.5,
    "smoothing": 0.65,
    "morphology": "light"
  },
  "background": {
    "effect": "color",
    "folder": "testdata",
    "loopIfVideo": false,
    "overlayColor": "0,255,0",
    "overlayAlpha": 1.0
  },
  "pause": {
    "enabled": false,
    "source": "image",
    "image": "sample_pause.jpg",
    "folder": "testdata",
    "loopIfVideo": false,
    "showStatusText": true,
    "textColor": "ffffffff",
    "textPosition": "auto",
    "textSize": 1.6,
    "font": "simplex",
    "fontDirectory": "/opt/JONImageProcessor/var/fonts",
    "fontAlign": "left"
  },
  "output": {
    "size": "auto"
  },
  "ipc": {
    "socket": "/tmp/jonimageprocessor.sock"
  },
  "display": {
    "backend": "drm",
    "mode": "fullscreen"
  },
  "diagnostics": {
    "benchmark": false
  }
}
